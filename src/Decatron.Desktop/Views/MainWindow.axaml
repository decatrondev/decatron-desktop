<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Decatron.Desktop.ViewModels"
        xmlns:sdk="using:Decatron.Desktop.Sdk"
        x:Class="Decatron.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/decatron.ico"
        Title="Decatron Desktop"
        Width="980" Height="640" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GraphiteBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Grid RowDefinitions="38,*,Auto">

    <!-- Barra de título propia: sin chrome nativo en ninguna plataforma. -->
    <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}" ColumnDefinitions="Auto,*,Auto"
          PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
        <Image Source="/Assets/decatron.png" Width="18" Height="18" />
        <TextBlock Text="Decatron" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Text="Desktop" FontSize="14" Foreground="{StaticResource InkMutedBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Classes="TitleBarButton" Content="—" Click="OnMinimizeClick" />
        <Button Classes="TitleBarButton" Content="□" Click="OnMaximizeClick" />
        <Button Classes="TitleBarButton Close" Content="✕" Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <!-- Vinculación -->
    <Grid Grid.Row="1" IsVisible="{Binding !IsLinked}">
      <Border Classes="Card" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
        <StackPanel Spacing="14">
          <TextBlock Text="Vincula esta PC con tu canal" Classes="H1" />
          <TextBlock Classes="Muted" TextWrapping="Wrap"
                     Text="En el dashboard de Decatron ve a Ajustes → Decatron Desktop y pulsa «Vincular app». Copia aquí el código que aparece; vale 10 minutos y se usa una sola vez." />
          <TextBox Text="{Binding LinkCode}" Watermark="XXXX-XXXX" FontSize="22" FontWeight="SemiBold"
                   HorizontalContentAlignment="Center" MaxLength="9" />
          <TextBlock Text="{Binding LinkError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding LinkError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Button Classes="Primary" Content="Vincular" Command="{Binding LinkCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
          <Button Content="Abrir el dashboard" Command="{Binding OpenDashboardCommand}" HorizontalAlignment="Center"
                  Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentLightBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- App vinculada: barra lateral de módulos + vista del módulo -->
    <Grid Grid.Row="1" ColumnDefinitions="220,*" IsVisible="{Binding IsLinked}">
      <Border Grid.Column="0" Background="{StaticResource GraphiteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="4,8,4,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="StatusDot"
                       Classes.On="{Binding ConnectionState, Converter={x:Static vm:StateConverters.IsConnected}}" />
              <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding LatencyText}" FontSize="11" Foreground="{StaticResource InkFaintBrush}"
                       IsVisible="{Binding LatencyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="{StaticResource InkFaintBrush}" />
            <Button Content="Desvincular" Command="{Binding UnlinkCommand}" FontSize="11" Padding="8,4"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkFaintBrush}" HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="MÓDULOS" FontSize="11" Foreground="{StaticResource InkFaintBrush}" Margin="8,4,0,8" />
          <ListBox Classes="Nav" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MainViewModel+ModuleEntry">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Icon}" FontSize="15" />
                  <TextBlock Text="{Binding Title}" FontSize="13" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>

    <!-- Aviso de actualización -->
    <Border Grid.Row="2" Background="#339146FF" Padding="14,8"
            IsVisible="{Binding UpdateBanner, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding UpdateBanner}" FontSize="12" />
    </Border>
  </Grid>
</Window>
