<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.H1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.H2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.Stat">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="Border.Notice">
    <Setter Property="Background" Value="#26A970FF" />
  </Style>
  <Style Selector="Border.Notice.Error">
    <Setter Property="Background" Value="#26EF4444" />
  </Style>

  <Style Selector="Border.Pill">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.Pill.Active">
    <Setter Property="Background" Value="#339146FF" />
  </Style>

  <Style Selector="Ellipse.StatusDot">
    <Setter Property="Fill" Value="{StaticResource InkFaintBrush}" />
  </Style>
  <Style Selector="Ellipse.StatusDot.On">
    <Setter Property="Fill" Value="{StaticResource LiveBrush}" />
  </Style>

  <Style Selector="ProgressBar.Level">
    <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ProgressBar.Level.Voice">
    <Setter Property="Foreground" Value="{StaticResource LiveBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.Danger">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F87171" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Botones de la barra de título propia -->
  <Style Selector="Button.TitleBarButton">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button.TitleBarButton.Close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Barra lateral de módulos -->
  <Style Selector="ListBox.Nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#339146FF" />
  </Style>
  <Style Selector="ListBox.Nav ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
</Styles>
