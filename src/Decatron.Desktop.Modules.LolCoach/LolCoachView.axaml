<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decatron.Desktop.Modules.LolCoach"
             x:Class="Decatron.Desktop.Modules.LolCoach.LolCoachView"
             x:DataType="vm:LolCoachViewModel">

  <ScrollViewer>
    <StackPanel Margin="28,24" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Text="Decatron Coach · League of Legends" Classes="H1" />
        <TextBlock Classes="Muted" TextWrapping="Wrap"
                   Text="Lee el cliente de LoL en tu PC (lobby, selección de campeón, partida, resultado) y lo manda al overlay al instante. Solo lectura: no acepta colas, no lockea ni toca nada del juego." />
      </StackPanel>

      <Border Classes="Card">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="10" Height="10" VerticalAlignment="Center" Classes.On="{Binding ClientDetected}" Classes="StatusDot" />
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding PhaseText}" />
            </StackPanel>
            <TextBlock Classes="Muted" Text="{Binding SummonerText, StringFormat='Invocador: {0}'}" />
            <TextBlock Classes="Muted" Text="{Binding MatchText}" TextWrapping="Wrap" IsVisible="{Binding MatchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="Muted" Text="{Binding LinkedText, StringFormat='Cuentas vinculadas en el dashboard: {0}'}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
            <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="Activo" OffContent="Pausado" />
            <Button Content="Detectar cuenta" Command="{Binding RescanCommand}" ToolTip.Tip="Vuelve a buscar el cliente de LoL y a comprobar la cuenta con el servidor" />
          </StackPanel>

          <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="12,8" CornerRadius="8" Classes="Notice Error"
                  IsVisible="{Binding !SummonerLinked}">
            <TextBlock TextWrapping="Wrap" FontSize="13"
                       Text="La cuenta abierta en el cliente no coincide con ninguna vinculada en el dashboard: el overlay no va a mostrar nada. Vincúlala en Overlays → Game Overlays → Cuentas y pulsa 'Detectar cuenta'." />
          </Border>
          <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="12,8" CornerRadius="8"
                  IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Classes="Notice" Classes.Error="{Binding MessageIsError}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
          </Border>
        </Grid>
      </Border>

      <Border Classes="Card">
        <StackPanel Spacing="12">
          <TextBlock Text="Cliente de LoL" Classes="H2" />
          <TextBlock Classes="Muted" TextWrapping="Wrap"
                     Text="Se busca solo (instalación estándar de Riot). Si tienes LoL en otra carpeta, pon aquí la ruta de la carpeta 'League of Legends' o de su archivo 'lockfile'." />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding LockfilePath}" Watermark="C:\Riot Games\League of Legends" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Detectar cuenta" Command="{Binding RescanCommand}" />
          </Grid>
          <TextBlock Classes="Muted" FontSize="12" Text="{Binding LastSentText, StringFormat='Último envío al servidor: {0}'}" />
        </StackPanel>
      </Border>

      <Border Classes="Card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Classes.On="{Binding CoachEnabled}" Classes="StatusDot" />
            <TextBlock Text="{Binding CoachName, StringFormat='Coach: {0}'}" Classes="H2" />
          </StackPanel>
          <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding CoachStatusText}" />
          <ItemsControl ItemsSource="{Binding CoachMessages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="Pill" Margin="0,0,0,8" Padding="12,8" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="Muted" FontSize="11" />
                    </Grid>
                    <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" FontSize="13" />
                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" Classes="Muted"
                               IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="Card">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Classes.On="{Binding Speaking}" Classes="StatusDot" />
            <TextBlock Text="Voz del coach" Classes="H2" />
          </StackPanel>
          <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding VoiceText}" />
          <TextBlock Classes="Muted" TextWrapping="Wrap" IsVisible="{Binding !PlayerSupported}" Text="La reproducción de audio no está disponible en este sistema." />
          <StackPanel Spacing="10" IsVisible="{Binding PlayerSupported}">
            <TextBlock Classes="Muted" TextWrapping="Wrap"
                       Text="Elige por dónde suena: tus auriculares (solo tú lo oyes) o el dispositivo que captura OBS (lo oye el chat)." IsVisible="{Binding CanPickOutput}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanPickOutput}">
              <ComboBox Grid.Column="0" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Margin="8,0,0,0" Content="↻" Command="{Binding RefreshOutputDevicesCommand}" ToolTip.Tip="Volver a buscar dispositivos de salida" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <TextBlock Classes="Muted" VerticalAlignment="Center" Text="Volumen" />
              <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="1" Value="{Binding Volume}" />
              <Button Grid.Column="2" Content="Repetir último" Command="{Binding ReplayLastCommand}" Margin="0,0,8,0" />
              <Button Grid.Column="3" Content="Callar" Command="{Binding StopSpeakingCommand}" Classes="Danger" IsVisible="{Binding Speaking}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="Card">
        <StackPanel Spacing="8">
          <TextBlock Text="Qué ve el overlay" Classes="H2" />
          <TextBlock Classes="Muted" TextWrapping="Wrap" Text="• Lobby: con quién estás y qué cola. • Buscando partida. • Selección de campeón: picks de tu equipo (el tuyo resaltado), del rival y bans, en tiempo real. • En partida: campeón, rol y cronómetro. • Fin de partida: resultado, KDA, CS, daño y ±LP." />
          <TextBlock Classes="Muted" TextWrapping="Wrap" Text="Activa los elementos 'Selección de campeón', 'Fin de partida' y 'Coach dice' en Overlays → Game Overlays → Diseño. La voz se activa en el dashboard (Decatron Coach → Voz)." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
